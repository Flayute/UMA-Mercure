<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <!-- cabecera -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/brand" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="UMA MERCURE"
            android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/statusChip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="· sin conexión"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="@drawable/btn_ghost" android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <ImageButton android:id="@+id/btnSettings" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_stat" android:background="?android:attr/selectableItemBackground"
            android:contentDescription="ajustes" android:scaleType="centerInside" />
    </LinearLayout>

    <!-- tarjeta now playing -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg" android:layout_margin="14dp"
        android:padding="16dp">
        <TextView android:id="@+id/trackTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Sin reproducción"
            android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/trackArtist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="—"
            android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="2dp" />
        <TextView android:id="@+id/metaLine" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text=""
            android:textColor="@color/accent" android:textSize="12sp" android:layout_marginTop="8dp" />
        <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:max="1000" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/tPos" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="0:00"
                android:textColor="@color/text_muted" android:textColorHint="@color/text_muted"
                android:textSize="11sp" />
            <TextView android:id="@+id/tDur" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0:00"
                android:textColor="@color/text_muted" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
            <Button android:id="@+id/btnPrev" android:layout_width="56dp" android:layout_height="46dp"
                android:text="⏮" android:textSize="16sp" android:textColor="@color/text_primary"
                android:background="@drawable/btn_ghost" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnPlay" android:layout_width="76dp" android:layout_height="46dp"
                android:text="▶" android:textSize="18sp" android:textStyle="bold" android:textColor="#ffffff"
                android:background="@drawable/btn_ghost" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnNext" android:layout_width="56dp" android:layout_height="46dp"
                android:text="⏭" android:textSize="16sp" android:textColor="@color/text_primary"
                android:background="@drawable/btn_ghost" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnStop" android:layout_width="56dp" android:layout_height="46dp"
                android:text="⏹" android:textSize="16sp" android:textColor="@color/text_primary"
                android:background="@drawable/btn_ghost" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="volumen" android:textColor="@color/text_secondary" android:textSize="11sp" />
            <SeekBar android:id="@+id/vol" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="100" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/btnSession" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="40dp" android:text="Crear sesión propia"
                android:textSize="12sp" android:textColor="@color/text_primary"
                android:background="@drawable/btn_ghost" />
            <Button android:id="@+id/btnShuffle" android:layout_width="wrap_content"
                android:layout_height="40dp" android:text="Aleatorio" android:textSize="12sp"
                android:textColor="@color/text_primary" android:background="@drawable/btn_ghost"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- pestañas -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
        <Button android:id="@+id/tabQueue" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:text="Cola" android:textSize="12sp"
            android:textColor="@color/accent" android:background="@drawable/btn_ghost"
            android:layout_marginEnd="6dp" />
        <Button android:id="@+id/tabSearch" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:text="Buscar" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:background="@drawable/btn_ghost"
            android:layout_marginEnd="6dp" />
        <Button android:id="@+id/tabDJ" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:text="DJ (LLM)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:background="@drawable/btn_ghost" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp">
        <EditText android:id="@+id/searchBox" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="busca artista, título, género, bpm…" android:textSize="13sp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
            android:background="@drawable/card_bg" android:padding="12dp" android:visibility="gone"
            android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true"
            android:gravity="top|start" android:minHeight="46dp" />
        <ImageButton android:id="@+id/btnGo" android:layout_width="46dp" android:layout_height="46dp"
            android:src="@drawable/ic_stat" android:background="@drawable/btn_ghost"
            android:contentDescription="ejecutar" android:scaleType="centerInside"
            android:visibility="gone" android:layout_marginStart="6dp" />
        <ImageButton android:id="@+id/btnClear" android:layout_width="46dp" android:layout_height="46dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@drawable/btn_ghost"
            android:contentDescription="borrar y detener la lista del DJ"
            android:scaleType="centerInside" android:visibility="gone"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:divider="@color/border"
        android:dividerHeight="1dp" />
</LinearLayout>

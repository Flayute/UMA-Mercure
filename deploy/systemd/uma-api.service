[Unit]
Description=UMA Mercure - FastAPI Gateway
After=uma-llama.service mpd.service
Requires=uma-llama.service

[Service]
Type=simple
User=<usuario>
WorkingDirectory=/home/<usuario>/UMA-Mercure/api
ExecStart=/home/<usuario>/UMA-Mercure/api/venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
